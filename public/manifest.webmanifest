{
  "name": "SimpleConfigDiff",
  "short_name": "configdiff",
  "description": "Diff config files by structure, not by line. Runs entirely in the browser.",
  "start_url": "/SimpleConfigDiff/",
  "scope": "/SimpleConfigDiff/",
  "display": "standalone",
  "background_color": "#0b0d0e",
  "theme_color": "#0b0d0e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
