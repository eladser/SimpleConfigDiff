{
  "name": "simple-config-diff",
  "version": "2.0.0",
  "description": "A browser-based tool that compares configuration files and outputs human-friendly structured diffs",
  "homepage": "https://eladser.github.io/SimpleConfigDiff/",
  "bin": {
    "configdiff": "./bin/configdiff.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "cli": "node bin/configdiff.js"
  },
  "keywords": [
    "config",
    "diff",
    "json",
    "yaml",
    "xml",
    "ini",
    "toml",
    "env",
    "comparison",
    "configuration",
    "cli",
    "command-line",
    "batch",
    "directory"
  ],
  "author": "eladser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eladser/SimpleConfigDiff.git"
  },
  "bugs": "https://github.com/eladser/SimpleConfigDiff/issues",
  "funding": "https://ko-fi.com/eladser",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.8.0",
    "ini": "^7.0.0",
    "js-yaml": "^4.2.0",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/ini": "^4.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "lucide-react": "^1.17.0",
    "postcss": "^8.4.32",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
